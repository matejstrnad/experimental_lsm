#!/bin/sh
# explsm prerm: before explsm's files are replaced or removed.
#
# remove, deconfigure: turn explsm off. Unloading drops the pins and labels
# and stops explsmd, so dpkg may change explsm's own files even with
# `root_bypass off`.
#
# upgrade: only stop explsmd. The pinned programs go on enforcing while dpkg
# replaces the files, which root may with the bypass on or in audit mode,
# and postinst lets the new explsmd take over if its map layout is the same
# (otherwise it unloads then). With the bypass off that needs dpkg to be an
# app granted explsm's own files (examples/dpkg.explsm), which status shows
# as `dpkg -> explsmd: …`. Otherwise, or with no daemon to ask, explsm is
# unloaded as for a removal and is off for the few seconds an upgrade takes.
set -e

# Through the daemon, or, with none running, by the installed explsmd.
unload() {
    if [ -x /usr/bin/explsmctl ] && explsmctl unload; then
        return 0
    fi
    if [ -x /usr/sbin/explsmd ] && [ -e /sys/fs/bpf/explsm ]; then
        /usr/sbin/explsmd --unload || true
    fi
}

stop() {
    if [ -d /run/systemd/system ]; then
        systemctl stop explsmd.service >/dev/null 2>&1 || true
    fi
}

# Whether dpkg gets to replace explsm's files with explsm loaded: perms are
# listed in the order read, write, create, delete, rename, list, setattr.
dpkg_may() {
    [ -x /usr/bin/explsmctl ] || return 1
    status=$(explsmctl status 2>/dev/null) || return 1
    printf '%s\n' "$status" | grep -Eq '^root bypass (on|audit)' && return 0
    printf '%s\n' "$status" |
        grep -Eq '^  dpkg -> explsmd: (all|.*write, create, delete, rename)'
}

case "$1" in
upgrade|failed-upgrade)
    if ! dpkg_may; then
        unload
    fi
    stop
    ;;
remove|deconfigure)
    unload
    stop
    if [ "$1" = remove ]; then
        systemctl disable explsmd.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
